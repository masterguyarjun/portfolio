# MasterGuyArjun Portfolio - Environment Variables Example
# Copy this file to .env.local for local development
# NO SECRETS SHOULD BE COMMITTED TO VERSION CONTROL

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://masterguyarjun.online
NEXT_PUBLIC_SITE_NAME=MasterGuyArjun

# Contact Form (optional - for production deployment with form backend)
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact
# RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key  # NEVER commit this!

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Build-time Configuration (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_CONTACT_FORM=false
